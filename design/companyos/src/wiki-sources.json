        "number": 14,
        "text": "pub(crate) fn plan_folder_workspace("
      },
      {
        "number": 15,
        "text": "    workspace: &ProjectWorkspace,"
      },
      {
        "number": 16,
        "text": "    root_event_id: &str,"
      },
      {
        "number": 17,
        "text": ") -> Result<ThreadWorkspacePlan> {"
      },
      {
        "number": 18,
        "text": "    validate_root_event_id(root_event_id)?;"
      },
      {
        "number": 19,
        "text": "    let folder = super::canonicalize_project_workspace(&workspace.local_path)?;"
      },
      {
        "number": 20,
        "text": "    if !folder.is_dir() {"
      },
      {
        "number": 21,
        "text": "        bail!(\"Project workspace is not a folder: {}\", folder.display());"
      },
      {
        "number": 22,
        "text": "    }"
      },
      {
        "number": 23,
        "text": "    let history_root = buzz_cowork::history_dir_from_env()"
      },
      {
        "number": 24,
        "text": "        .context(\"version history location is not configured\")?;"
      },
      {
        "number": 25,
        "text": "    let opened = buzz_cowork::ShadowRepo::open_or_init("
      },
      {
        "number": 26,
        "text": "        &history_root,"
      },
      {
        "number": 27,
        "text": "        &workspace.repo_address,"
      },
      {
        "number": 28,
        "text": "        &folder,"
      },
      {
        "number": 29,
        "text": "        None,"
      },
      {
        "number": 30,
        "text": "    )"
      },
      {
        "number": 31,
        "text": "    .map_err(|error| anyhow::anyhow!(\"{error}\"))?;"
      },
      {
        "number": 32,
        "text": "    if opened.rebuilt {"
      },
      {
        "number": 33,
        "text": "        tracing::warn!("
      },
      {
        "number": 34,
        "text": "            repo = %workspace.repo_address,"
      },
      {
        "number": 35,
        "text": "            notice = opened.notice.as_deref().unwrap_or(\"\"),"
      },
      {
        "number": 36,
        "text": "            \"cowork version history was rebuilt after corruption\""
      }
